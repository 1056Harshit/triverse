{
  "name": "@triverse/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test DATABASE_URL=pglite:memory tsx --test src/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@electric-sql/pglite": "^0.5.8",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@huggingface/transformers": "^4.3.0",
    "@triverse/emails": "*",
    "@triverse/shared": "*",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.12.5",
    "ffmpeg-static": "^5.3.0",
    "google-auth-library": "^11.1.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.14",
    "postgres": "^3.4.5",
    "resend": "^6.32.0",
    "sharp": "^0.34.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.23.15"
  }
}
