NODE_ENV=development
PORT=4000
APP_URL=https://pvtfrnd.com
DATABASE_URL=postgres://triverse:triverse@localhost:5432/triverse
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars
OTP_PEPPER=change-me-too-16-plus-chars
# Logs OTP codes instead of sending them. Never enable in production.
OTP_DEV_ECHO=true

ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# Free option: get a Gemini key at aistudio.google.com/apikey (used when ANTHROPIC_API_KEY is empty)
GEMINI_API_KEY=
# LLM_MODEL=gemini-3.8-flash

RESEND_API_KEY=
EMAIL_FROM=TriVerse <hello@pvtfrnd.com>
# Or send through Gmail: create an App Password at myaccount.google.com/apppasswords
# SMTP_URL=smtps://you%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
EMAIL_ASSET_BASE=https://pvtfrnd.com/brand
# Real SMS is off unless this is true (phone OTPs are shown in the app while testing)
SMS_ENABLED=false
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

# Comma-separated OAuth client IDs (web, iOS, Android)
GOOGLE_CLIENT_IDS=
APPLE_BUNDLE_ID=com.pvtfrnd.triverse

# Voice messages: leave empty to run Whisper locally (free), or use Sarvam for Indian languages
SARVAM_API_KEY=

GOOGLE_MAPS_API_KEY=
TRIPADVISOR_API_KEY=

KYC_PROVIDER=mock
SUREPASS_TOKEN=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
